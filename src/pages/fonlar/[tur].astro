---
import Base from "../../layouts/Base.astro";
import FundTable from "../../components/FundTable";
import { listFunds } from "../../lib/db";
import { trDate } from "../../lib/format";
import { SCANS } from "../../lib/scans";

const KINDS: Record<string, [string, string]> = {
  yat: ["YAT", "Yatırım Fonları"], bes: ["EMK", "Emeklilik Fonları (BES)"],
  byf: ["BYF", "Borsa Yatırım Fonları"], gyf: ["GYF", "Gayrimenkul Yatırım Fonları"],
};
const k = KINDS[Astro.params.tur ?? ""];
if (!k) return new Response(null, { status: 404 });
const { ref, funds } = await listFunds(k[0]);
const scans = SCANS.filter((s) => s.kind === k[0]);
---
<Base title={`${k[1]} · TEFAS Fon Analiz`} description={`${funds.filter((f) => f.active).length} aktif ${k[1].toLocaleLowerCase("tr")}: 1 günden 5 yıla getiri, büyüklük, nakit giriş-çıkışı ve risk; filtrele, sırala, karşılaştır. Veri tarihi ${trDate(ref)}.`}>
  <link slot="head" rel="preload" href={`/api/funds/${Astro.params.tur}`} as="fetch" crossorigin="anonymous" />
  <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4">
    <h1 class="text-xl font-semibold">{k[1]}</h1>
    <span class="text-sm text-muted-foreground">Veri tarihi: {trDate(ref)} · {funds.filter((f) => f.active).length} aktif fon</span>
  </div>
  {scans.length > 0 && (
    <div class="mb-3 hidden flex-wrap items-center gap-2 text-xs sm:flex" data-testid="hazir-taramalar">
      <span class="text-muted-foreground">Hazır taramalar:</span>
      {scans.map((s) => <a class="max-w-full truncate rounded-full border px-2 py-0.5 hover:bg-accent" href={`/tarama/${s.slug}`}>{s.title}</a>)}
    </div>
  )}
  {funds.length === 0
    ? <p class="text-muted-foreground">Veri henüz yüklenmedi; ilk yükleme ~20 dk sürer (TEFAS rate limit). Sayfayı sonra yenileyin.</p>
    : <FundTable client:only="react" src={`/api/funds/${Astro.params.tur}`} />}
</Base>
