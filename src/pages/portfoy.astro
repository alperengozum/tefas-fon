---
import Base from "../layouts/Base.astro";
import CompareChart from "../components/CompareChart";
import Matrix from "../components/Matrix.astro";
import PortfolioForm from "../components/PortfolioForm";
import { getBench, getFunds } from "../lib/db";
import { BENCH, forChart, ret, RETURNS } from "../lib/analytics";
import { corr, dailyReturns, overlap } from "../lib/stats";
import { label, pct, tl, tone } from "../lib/format";

// ?f=AFT:tl:5000&f=TCD:adet:120 (fon:tl|adet:değer, tekrarlı parametre). Form tarayıcıda localStorage'a kaydeder, URL paylaşılabilir.
const entered = Astro.url.searchParams.getAll("f").flatMap((s) => {
  const [c, m, v] = s.split(":");
  const n = Number(v);
  return c && (m === "tl" || m === "adet") && n > 0 ? [{ code: c.toUpperCase(), mode: m as "tl" | "adet", value: n }] : [];
}).slice(0, 15);
const codes = [...new Set(entered.map((e) => e.code))];
const [{ funds, holdings }, bench] = await Promise.all([getFunds(codes), codes.length ? getBench() : Promise.resolve({} as Awaited<ReturnType<typeof getBench>>)]);
const missing = codes.filter((c) => !funds.some((f) => f.code === c));
// tutar (TL): adet girildiyse güncel fiyatla çarpılır; aynı fon birden çok satırdaysa toplanır
const price = new Map(funds.map((f) => [f.code, f.history.at(-1)!.price]));
const amounts = new Map<string, number>();
const units = new Map<string, number>();
for (const e of entered) {
  const p = price.get(e.code);
  if (!p) continue;
  const u = e.mode === "adet" ? e.value : e.value / p;
  units.set(e.code, (units.get(e.code) ?? 0) + u);
  amounts.set(e.code, (amounts.get(e.code) ?? 0) + u * p);
}
const total = funds.reduce((s, f) => s + amounts.get(f.code)!, 0);
const w = (code: string) => amounts.get(code)! / total;

// Varlık dağılımı ve hisse maruziyeti: tutar ağırlıklı toplam
const alloc = new Map<string, number>();
for (const f of funds) for (const [k, v] of Object.entries(f.alloc)) alloc.set(k, (alloc.get(k) ?? 0) + v * w(f.code));
const allocRows = [...alloc].filter(([, v]) => v >= 0.05).sort((a, b) => b[1] - a[1]);
const expo = new Map<string, { pct: number; funds: string[] }>();
for (const f of funds) for (const h of holdings.get(f.code) ?? []) {
  const e = expo.get(h.ticker) ?? expo.set(h.ticker, { pct: 0, funds: [] }).get(h.ticker)!;
  e.pct += h.weight * w(f.code); e.funds.push(f.code);
}
const stocks = [...expo].sort((a, b) => b[1].pct - a[1].pct);
const noList = funds.filter((f) => (f.alloc.hs ?? 0) > 0 && !holdings.get(f.code)?.length).map((f) => f.code);
const stockPct = allocRows.find(([k]) => k === "hs")?.[1] ?? 0;
const covered = stocks.reduce((s, [, e]) => s + e.pct, 0);

// Geriye dönük değer serisi: bugünkü lot sayılarını (tutar / son fiyat) tüm fonların ortak günlerinde fiyatla çarp
const maps = funds.map((f) => new Map(f.history.map((r) => [r.date, r.price])));
const series = funds.length
  ? [...maps[0].keys()].filter((d) => maps.every((m) => m.has(d))).sort().map((date) => ({ date, price: funds.reduce((s, f, i) => s + units.get(f.code)! * maps[i].get(date)!, 0) }))
  : [];
const since = new Date(Date.now() - 365 * 864e5).toISOString().slice(0, 10);
const rets = funds.map((f) => dailyReturns(f.history, since));
const ids = funds.map((f) => f.code);
const cors = rets.map((a) => rets.map((b) => corr(a, b)));
const ovl = funds.map((a) => funds.map((b) => { const x = holdings.get(a.code), y = holdings.get(b.code); return x?.length && y?.length ? overlap(x, y) : null; }));
const hasOvl = ovl.some((r, i) => r.some((v, j) => i !== j && v != null));
const initial = entered.map((e) => ({ code: e.code, mode: e.mode, value: String(e.value) }));
---
<Base title="Portföyüm · TEFAS Fon Analiz">
  <h1 class="mb-1 text-xl font-semibold">Portföyüm</h1>
  <p class="mb-4 text-sm text-muted-foreground">Fonlarını seç, tutar (₺) ya da adet (pay) gir; birleşik varlık dağılımı, hisse maruziyeti ve fonlar arası örtüşme çıkar. Kayıt yalnız bu tarayıcıda tutulur; adres paylaşılabilir.</p>
  <PortfolioForm client:only="react" initial={initial} />
  {missing.length > 0 && <p class="mb-3 text-sm text-red-600">Bulunamadı: {missing.join(", ")}</p>}
  {funds.length === 0 ? <p class="text-muted-foreground">Analiz için en az bir fon ve tutar girin.</p> : (
    <>
      <div class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4">
        {[["Toplam değer", tl(total)], ["Fon sayısı", String(funds.length)], ["Hisse oranı", `${stockPct.toFixed(1)}%`], ["Listesi bilinen hisse", `${covered.toFixed(1)}%`]].map(([k, v]) => (
          <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">{k}</div><div class="text-lg font-medium tabular-nums">{v}</div></div>
        ))}
      </div>

      <section class="mb-8">
        <h2 class="mb-3 font-semibold">Fonlar</h2>
        <div class="overflow-x-auto rounded-lg border">
          <table class="w-full text-sm tabular-nums">
            <thead class="bg-muted/50 text-right"><tr><th class="p-2 text-left">Fon</th><th class="p-2">Adet</th><th class="p-2">Fiyat</th><th class="p-2">Tutar</th><th class="p-2">Pay</th></tr></thead>
            <tbody>{funds.map((f) => (
              <tr class="border-t"><td class="p-2 text-left"><a class="hover:underline" href={`/fon/${f.code}`}><b>{f.code}</b> <span class="text-muted-foreground">{f.name}</span></a></td><td class="p-2 text-right">{units.get(f.code)!.toLocaleString("tr-TR", { maximumFractionDigits: 2 })}</td><td class="p-2 text-right">{price.get(f.code)!.toFixed(4)}</td><td class="p-2 text-right">{tl(amounts.get(f.code))}</td><td class="p-2 text-right">{(w(f.code) * 100).toFixed(1)}%</td></tr>
            ))}</tbody>
          </table>
        </div>
      </section>

      {series.length > 20 && (
        <section class="mb-8">
          <h2 class="mb-3 font-semibold">Geçmiş performans <span class="text-xs font-normal text-muted-foreground">bugünkü lot sayılarını geçmişte de tutmuş gibi (fonların ortak günleri)</span></h2>
          <div class="mb-3 grid grid-cols-3 gap-3 md:grid-cols-5 lg:grid-cols-9">
            {RETURNS.map(([k, d]) => { const r = ret(series, d); return <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">{k}</div><div class={`font-medium tabular-nums ${tone(r)}`}>{pct(r)}</div></div>; })}
          </div>
          <CompareChart client:only="react" series={[{ code: "PORTFOY", name: "Portföyüm", history: forChart(series, ["price"]) }, ...BENCH.filter(([k]) => bench[k]).map(([k, l]) => ({ code: k, name: l, history: forChart(bench[k], ["price"]) }))]} />
        </section>
      )}

      <div class="mb-8 grid gap-8 md:grid-cols-2">
        <section>
          <h2 class="mb-3 font-semibold">Birleşik varlık dağılımı</h2>
          <ul class="space-y-1.5 text-sm">
            {allocRows.map(([k, v]) => (
              <li><div class="flex justify-between"><span>{label(k)}</span><span class="tabular-nums">{v.toFixed(2)}%</span></div><div class="h-1.5 rounded bg-muted"><div class="h-1.5 rounded bg-primary" style={`width:${Math.min(v, 100)}%`} /></div></li>
            ))}
          </ul>
        </section>
        <section>
          <h2 class="mb-3 font-semibold">Hisse maruziyeti <span class="text-xs font-normal text-muted-foreground">portföy değerine %, KAP raporlarından</span></h2>
          {stocks.length === 0 ? <p class="text-sm text-muted-foreground">Fonların KAP hisse listesi yok.</p> : (
            <ul class="space-y-1.5 text-sm">
              {stocks.slice(0, 20).map(([t, e]) => (
                <li>
                  <div class="flex justify-between"><span><a class="font-medium hover:underline" href={`/hisse/${t}`}>{t}</a> {e.funds.length > 1 && <span class="text-xs text-amber-600" title={e.funds.join(", ")}>{e.funds.length} fonda</span>}</span><span class="tabular-nums">{e.pct.toFixed(2)}% · {tl((e.pct / 100) * total)}</span></div>
                  <div class="h-1.5 rounded bg-muted"><div class="h-1.5 rounded bg-primary" style={`width:${Math.min(e.pct * 4, 100)}%`} /></div>
                </li>
              ))}
            </ul>
          )}
          {noList.length > 0 && <p class="mt-3 text-xs text-muted-foreground">Hisse tutan ama listesi olmayan fonlar: {noList.join(", ")} (bu kısım maruziyete dahil değil).</p>}
        </section>
      </div>

      {funds.length > 1 && (
        <section class="mb-8 grid gap-6 lg:grid-cols-2">
          <div><h2 class="mb-2 font-semibold">Getiri korelasyonu <span class="text-xs font-normal text-muted-foreground">son 1 yıl · yüksekse çeşitlendirme az</span></h2><Matrix codes={ids} cells={cors} kind="corr" /></div>
          {hasOvl && <div><h2 class="mb-2 font-semibold">Hisse örtüşmesi <span class="text-xs font-normal text-muted-foreground">ortak hisse ağırlığı toplamı</span></h2><Matrix codes={ids} cells={ovl} kind="pct" /></div>}
        </section>
      )}
    </>
  )}
</Base>
