---
import Base from "../layouts/Base.astro";
import FundPicker from "../components/FundCombobox";
import { getBench, getFunds, type Detail } from "../lib/db";
import { BENCH } from "../lib/analytics";
import { simulate, type Sim } from "../lib/stats";
import { afterTax, stopajRate } from "../lib/portfolio";
import { classify } from "../lib/classify";
import { pct, tl, tone } from "../lib/format";

const q = Astro.url.searchParams;
const codes = [...new Set(q.getAll("codes").flatMap((s) => s.toUpperCase().split(",")).map((c) => c.trim()).filter(Boolean))].slice(0, 6);
const monthly = Math.min(Math.max(Number(q.get("monthly")) || 5000, 1), 1e9);
const today = new Date().toISOString().slice(0, 10);
const isDate = (s: string | null) => (s && /^\d{4}-\d{2}-\d{2}$/.test(s) && !isNaN(Date.parse(s)) ? s : null);
const start = isDate(q.get("start")) ?? new Date(Date.now() - 365 * 864e5).toISOString().slice(0, 10);
const end = isDate(q.get("end")) ?? today;

// Sonuç yalnız fon seçilip Hesapla'ya basılınca (adreste codes varken) hesaplanır ve gösterilir
const calc = codes.length > 0;
const [{ funds }, bench] = calc ? await Promise.all([getFunds(codes), getBench()]) : [{ funds: [] }, {} as Awaited<ReturnType<typeof getBench>>];
// Stopaj sonrası net (yalnız fonlar): SIP'te her alım kendi elde tutma süresiyle; tek seferlik başlangıç gününden
const net = (f: Detail, sim: Sim | null) => {
  if (!sim) return null;
  const tf = { kind: f.kind, name: f.name, stockFocus: classify(f.name, f.kind).stockFocus, stock: f.alloc.hs ?? 0 };
  const units = sim.lots.reduce((s, l) => s + l.units, 0);
  const sip = afterTax(tf, sim.lots, sim.value / units, sim.last);
  const rate = stopajRate(tf, sim.start, sim.last);
  return { sip: (sip.net / sim.invested - 1) * 100, lump: sim.lump - Math.max(0, sim.lump) * (rate ?? 0), rate };
};
const rows = [
  ...funds.map((f) => { const sim = simulate(f.history, monthly, start, end); return { code: f.code, name: f.name, sim, net: net(f, sim) }; }),
  ...BENCH.filter(([k]) => bench[k]).map(([k, l]) => ({ code: null, name: l, sim: simulate(bench[k], monthly, start, end), net: null })),
];
const missing = codes.filter((c) => !funds.some((f) => f.code === c));
---
<Base title="Simülasyon · TEFAS Fon Analiz">
  <h1 class="mb-1 text-xl font-semibold">Yatırım simülasyonu</h1>
  <p class="mb-4 text-sm text-muted-foreground">"Geçmişte şunu alsaydım ne olurdu?" Aylık düzenli alım (SIP) ve tek seferlik alımı fon ve endekslerle kıyaslar. Geçmiş getiri gelecek getiriyi garanti etmez; fon masrafı fiyata zaten yansır, stopaj sonrası net getiri ayrı sütunda.</p>
  <form class="mb-6 flex flex-wrap items-end gap-3 text-sm" method="get">
    <div class="flex flex-col gap-1">Fonlar <span class="text-xs text-muted-foreground">en fazla 6, endeksler her zaman eklenir</span><FundPicker client:only="react" name="codes" initial={codes} max={6} /></div>
    <label class="flex flex-col gap-1">Aylık tutar (₺)<input name="monthly" type="number" min="1" value={monthly} class="h-8 w-32 rounded-lg border bg-transparent px-2" /></label>
    <label class="flex flex-col gap-1">Başlangıç<input name="start" type="date" value={start} class="h-8 rounded-lg border bg-transparent px-2" /></label>
    <label class="flex flex-col gap-1">Bitiş<input name="end" type="date" value={end} class="h-8 rounded-lg border bg-transparent px-2" /></label>
    <button class="h-8 rounded-lg bg-primary px-3 text-primary-foreground">Hesapla</button>
  </form>
  {!calc && (q.has("monthly") ? <p class="text-sm text-red-600">Hesaplamak için en az bir fon seç.</p> : <p class="text-sm text-muted-foreground">Fon(lar)ı seç, aylık tutarı ve tarih aralığını gir, Hesapla'ya bas.</p>)}
  {calc && <>
  {missing.length > 0 && <p class="mb-3 text-sm text-red-600">Bulunamadı: {missing.join(", ")}</p>}
  <div class="overflow-x-auto rounded-lg border">
    <table class="w-full text-sm tabular-nums">
      <thead class="bg-muted/50 text-right">
        <tr><th class="p-2 text-left" rowspan="2">Varlık</th><th class="p-2 text-center" colspan="6">Aylık düzenli alım</th><th class="p-2 text-center" colspan="3">Başta tek seferlik</th></tr>
        <tr><th class="p-2">Alım</th><th class="p-2">Yatırılan</th><th class="p-2">Değer</th><th class="p-2">Getiri</th><th class="p-2">Yıllık (XIRR)</th><th class="p-2">Net (stopaj sonrası)</th><th class="p-2">Getiri</th><th class="p-2">Yıllık</th><th class="p-2">Net (stopaj sonrası)</th></tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class="border-t">
            <td class="p-2">{r.code ? <a class="hover:underline" href={`/fon/${r.code}`}><b>{r.code}</b> <span class="text-muted-foreground">{r.name}</span></a> : <span class="text-muted-foreground">{r.name}</span>}</td>
            {r.sim ? (
              <>
                <td class="p-2 text-right" title={`${r.sim.first} → ${r.sim.last}`}>{r.sim.n}</td>
                <td class="p-2 text-right">{tl(r.sim.invested)}</td>
                <td class="p-2 text-right">{tl(r.sim.value)}</td>
                <td class={`p-2 text-right ${tone(r.sim.ret)}`}>{pct(r.sim.ret)}</td>
                <td class={`p-2 text-right ${tone(r.sim.xirr)}`}>{r.sim.xirr == null ? "–" : pct(r.sim.xirr * 100)}</td>
                <td class={`p-2 text-right ${tone(r.net?.sip)}`} data-col="net-sip">{pct(r.net?.sip)}</td>
                <td class={`p-2 text-right ${tone(r.sim.lump)}`}>{pct(r.sim.lump)}</td>
                <td class={`p-2 text-right ${tone(r.sim.lumpAnn)}`}>{pct(r.sim.lumpAnn)}</td>
                <td class={`p-2 text-right ${tone(r.net?.lump)}`} data-col="net-lump" title={r.net ? (r.net.rate == null ? "BES: fon stopajı yok" : `stopaj %${(r.net.rate * 100).toFixed(1)}`) : undefined}>{pct(r.net?.lump)}</td>
              </>
            ) : <td class="p-2 text-muted-foreground" colspan="9">Bu aralıkta yeterli veri yok</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-3 text-xs text-muted-foreground">Her ay başlangıç günü aynı gün (yoksa sonraki işlem günü) alım yapılır; bitiş fiyatıyla değerlenir. Fon geçmişi ingest edilen kadardır (yaklaşık son 13 ay, günde bir uzar); daha eski başlangıçlarda "veri yok" çıkabilir. Yıllık oran 90 günden kısa sürede gösterilmez. Endeksler: BIST 100 (puan), USD/TRY, gram altın (Yahoo Finance).</p>
  <p class="mt-1 text-xs text-muted-foreground" data-testid="stopaj-not">Stopaj: güncel oranlar (9 Temmuz 2025 sonrası alımlar): genel %17,5; TEFAS'taki hisse senedi yoğun fonlar %0 (serbest olanlarda 27 Mart 2026 sonrası alımlar %17,5); hissesi ≥ %51 BYF 1 yıldan, GYF/GSYF 2 yıldan uzun tutulunca %0; BES'te fon stopajı yok. Yalnız kazançlı alımlar vergilenir. Daha önceki alımlara geçiş oranları uygulanır, burada hesaba katılmaz; vergi tavsiyesi değildir.</p>
  </>}
</Base>
