---
import Base from "../../layouts/Base.astro";
import FundCharts from "../../components/FundCharts";
import CompareChart from "../../components/CompareChart";
import PinButton from "../../components/PinButton";
import PremiumChart from "../../components/PremiumChart";
import { getBench, getFund, getFunds, getHoldings, getHoldingsChange, getNews, listFunds, overlapping, peers, riskFree } from "../../lib/db";
import { BENCH, forChart, inBase, ret, RETURNS } from "../../lib/analytics";
import { annualVol, beta, calendar, corr, dailyReturns, drawdown, rank, ratios, rolling } from "../../lib/stats";
import { label, pct, price, tl, tone, trDate } from "../../lib/format";
import { classify } from "../../lib/classify";
import { slug } from "../../lib/founders";
import { premiums, premiumStats } from "../../lib/premium";

const f = await getFund((Astro.params.code ?? "").toUpperCase());
if (!f) return new Response(null, { status: 404 }); // gövdesiz: Astro 404.astro sayfasını çizer
const founder = classify(f.name, f.kind).founder;
const TUR: Record<string, string> = { YAT: "yat", EMK: "bes", BYF: "byf", GYF: "gyf" };
const last = f.history[f.history.length - 1];
const bench = await getBench();
const benches = BENCH.filter(([s]) => bench[s]?.length);
// beta/korelasyon: son 1 yıl günlük getiriler, BIST100'e göre
const since = new Date(new Date(last.date).getTime() - 365 * 864e5).toISOString().slice(0, 10);
const fr = dailyReturns(f.history, since), br = bench.BIST100 ? dailyReturns(bench.BIST100, since) : null;
const [b100, c100] = br ? [beta(fr, br), corr(fr, br)] : [null, null];
const roll = rolling(f.history, 91);
// BYF: borsa bülten fiyatı ile NAV farkı (son 1 yıl)
const prem = f.kind === "BYF" ? premiumStats(f.history) : null;
// Risk: son 1 yıl en büyük düşüş, Sharpe/Sortino (risksiz = PPF medyanı), kategori (aynı tür, aktif) içi sıra, takvim getirileri
const [rf, { funds: listed }] = await Promise.all([riskFree(), listFunds(f.kind)]);
const dd = drawdown(f.history, since);
const rr = rf == null ? null : ratios(fr, rf);
const vol1 = annualVol(fr);
const me = listed.find((x) => x.code === f.code);
const cat = me?.active ? listed.filter((x) => x.active && x.type === me.type) : [];
const ranks = me ? ([["1A", "m1"], ["3A", "m3"], ["1Y", "y1"], ["3Y", "y3"], ["Maks. düşüş 1Y", "mdd"]] as const)
  .map(([k, key]) => [k, rank(me[key], cat.map((x) => x[key]))] as const).filter(([, r]) => r) : [];
const cal = calendar(f.history);
const MONTHS = ["Oca", "Şub", "Mar", "Nis", "May", "Haz", "Tem", "Ağu", "Eyl", "Eki", "Kas", "Ara"];
const p1 = (v: number | null) => (v == null ? "–" : `${v > 0 ? "+" : ""}${v.toFixed(1)}`);
const at = (d: number) => { const c = new Date(new Date(last.date).getTime() - d * 864e5).toISOString().slice(0, 10); return [...f.history].reverse().find((r) => r.date <= c); };
const flow = (d: number) => { const o = at(d); return o && last.price ? (last.shares - o.shares) * last.price : null; };
const [rivals, { holdings, report, published, note, seen }, overl, news, change] = await Promise.all([peers(f.code, f.kind), getHoldings(f.code), overlapping(f.code, 6), getNews(f.code), getHoldingsChange(f.code)]);
// Hisse tutan ama listesi olmayan fonlarda nedenini göster
const stockPct = f.alloc.hs ?? 0;
const why = holdings.length || stockPct <= 0 ? null
  : f.kind === "EMK" ? "BES fonlarının hisse bazlı portföyü KAP'ta yayımlanmıyor."
  : note === "muaf" ? "Nitelikli yatırımcı fonu: KAP portföy dağılım raporundan muaf, hisse listesi yayımlanmıyor."
  : f.name.startsWith("İŞ PORTFÖY") ? "İş Portföy raporları görüntü olarak yayımlanıyor (metin yok), okunamıyor."
  : seen ? "KAP portföy raporu bulundu ama tablo düzeni okunamadı."
  : "KAP'ta bu fon için portföy dağılım raporu bulunamadı.";
const top = rivals.slice(0, 4).map((r) => r.code);
const cmp = top.length ? (await getFunds([f.code, ...top])).funds : [];
const alloc = Object.entries(f.alloc).sort((a, b) => b[1] - a[1]);
const KIND_NAME: Record<string, [string, string]> = { YAT: ["Yatırım Fonları", "/fonlar/yat"], EMK: ["Emeklilik Fonları", "/fonlar/bes"], BYF: ["Borsa Yatırım Fonları", "/fonlar/byf"], GYF: ["Gayrimenkul Yatırım Fonları", "/fonlar/gyf"] };
---
<Base title={`${f.code} ${f.name} · TEFAS Fon Analiz`}
  description={`${f.code} ${f.name}: fiyat ${price(last.price)}, 1 yıllık getiri ${pct(ret(f.history, 365))}, büyüklük ${tl(last.size)}, ${last.investors?.toLocaleString("tr-TR") ?? "–"} yatırımcı (${trDate(last.date)}). Getiri, risk, varlık dağılımı, hisse portföyü ve rakipler.`}
  image={`/og/fon/${f.code}.png`} path={`/fon/${f.code}`}
  crumbs={[{ name: KIND_NAME[f.kind]?.[0] ?? "Fonlar", path: KIND_NAME[f.kind]?.[1] ?? "/fonlar/yat" }, { name: f.code, path: `/fon/${f.code}` }]}>
  <div class="mb-6">
    <div class="text-sm text-muted-foreground">{f.kind} · {trDate(last.date)} · {f.active ? "TEFAS'ta aktif" : <span class="font-medium text-red-600">TEFAS'ta pasif {f.tasfiye ? `(tasfiye duyurusu: ${trDate(f.tasfiye)})` : `(son veri ${trDate(last.date)})`}</span>}</div>
    <h1 class="break-words text-xl font-semibold sm:text-2xl">{f.code} <span class="text-base font-normal sm:text-lg text-muted-foreground">{f.name}</span></h1>
    <a class="no-print text-sm underline" href={`/kurucu/${slug(founder)}?tur=${TUR[f.kind] ?? "yat"}`} data-testid="kurucu-link">{founder}</a>
    <span class="no-print mx-1 text-muted-foreground">·</span><a class="no-print text-sm underline" href={`/karsilastir?codes=${f.code}`}>Karşılaştırmaya ekle</a>
    {f.kind === "EMK" && <><span class="no-print mx-1 text-muted-foreground">·</span><a class="no-print text-sm underline" href={`/bes-simulasyon?fon=${f.code}`}>BES simülasyonu</a></>}
    <span class="no-print mx-1 text-muted-foreground">·</span><span class="no-print"><PinButton client:only="react" code={f.code} /></span>
    <span class="no-print mx-1 text-muted-foreground">·</span><button type="button" class="no-print text-sm underline" onclick="window.print()">PDF olarak indir</button>
  </div>

  <div class="mb-6 grid grid-cols-2 gap-3 md:grid-cols-4">
    {[["Fiyat", price(last.price)], ["Büyüklük", tl(last.size)], ["Yatırımcı", last.investors?.toLocaleString("tr-TR")], ["Pay sayısı", tl(last.shares).replace(" ₺", "")]].map(([k, v]) => (
      <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">{k}</div><div class="text-lg font-medium tabular-nums">{v}</div></div>
    ))}
  </div>

  <div class="mb-6 grid grid-cols-3 gap-3 md:grid-cols-5 lg:grid-cols-9">
    {RETURNS.map(([k, d]) => { const r = ret(f.history, d); return (
      <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">{k}</div><div class={`font-medium tabular-nums ${tone(r)}`}>{pct(r)}</div></div>
    ); })}
  </div>

  <div class="mb-6 grid grid-cols-3 gap-3">
    {[["1H", 7], ["1A", 30], ["3A", 91]].map(([k, d]) => { const v = flow(d as number); return (
      <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">Net nakit akışı {k}</div><div class={`font-medium tabular-nums ${tone(v)}`}>{tl(v)}</div></div>
    ); })}
  </div>

  <section class="mb-8"><FundCharts client:only="react" history={forChart(f.history, ["price", "size", "investors"])} /></section>

  {prem && (
    <section class="mb-8" data-section="prim">
      <h2 class="mb-3 font-semibold">Borsa fiyatı ve prim/iskonto <span class="text-xs font-normal text-muted-foreground">TEFAS borsa bülten fiyatı · NAV = fonun birim pay değeri · {trDate(prem.last.date)}</span></h2>
      <div class="mb-3 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-6">
        {[["Borsa fiyatı", price(prem.last.bprice)], ["NAV", price(prem.last.nav)], ["Prim/iskonto", pct(prem.last.prem)],
          ["30 gün ort.", pct(prem.avg30)], ["1 yıl ort.", pct(prem.avg1y)], ["1 yıl aralık", `${pct(prem.min.prem)} / ${pct(prem.max.prem)}`]].map(([k, v]) => (
          <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">{k}</div><div class="font-medium tabular-nums">{v}</div></div>
        ))}
      </div>
      <p class="mb-3 text-sm text-muted-foreground">
        {Math.abs(prem.last.prem) < 0.25 ? "Borsa fiyatı NAV'a çok yakın." : prem.last.prem > 0 ? `Borsada NAV'ın %${prem.last.prem.toFixed(2)} üstünde (primli) işlem görüyor: borsadan alan, fonun gerçek değerinden fazla öder.` : `Borsada NAV'ın %${Math.abs(prem.last.prem).toFixed(2)} altında (iskontolu) işlem görüyor: borsadan alan, fonun gerçek değerinden az öder.`}
        {" "}Son 1 yılda NAV'dan ortalama sapma %{prem.absAvg1y?.toFixed(2)}{prem.absAvg1y != null && prem.absAvg1y > 1 ? " (yüksek: borsa fiyatı NAV'dan belirgin sapabiliyor)" : ""}.
      </p>
      <PremiumChart client:only="react" series={premiums(f.history, since)} />
    </section>
  )}

  {benches.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 font-semibold">Endekslere karşı <span class="text-xs font-normal text-muted-foreground">BIST 100, USD/TRY, gram altın (Yahoo Finance) · fon bunları geçti mi?</span></h2>
      <div class="mb-3 overflow-x-auto rounded-lg border">
        <table class="w-full text-sm tabular-nums">
          <thead class="bg-muted/50 text-right"><tr><th class="p-2 text-left"></th>{RETURNS.map(([k]) => <th class="p-2">{k}</th>)}</tr></thead>
          <tbody>
            {[[f.code, f.history] as const, ...benches.map(([s, l]) => [l, bench[s]] as const)].map(([l, h], i) => (
              <tr class={`border-t ${i === 0 ? "font-medium" : ""}`}><td class="p-2 text-left">{l}</td>{RETURNS.map(([, d]) => { const r = ret(h, d); return <td class={`p-2 text-right ${tone(r)}`}>{pct(r)}</td>; })}</tr>
            ))}
            {bench.USD && (
              <tr class="border-t bg-muted/30 font-medium" data-testid="usd-satir"><td class="p-2 text-left">{f.code} USD bazında</td>{RETURNS.map(([, d]) => { const r = inBase(ret(f.history, d), ret(bench.USD, d)); return <td class={`p-2 text-right ${tone(r)}`}>{pct(r)}</td>; })}</tr>
            )}
          </tbody>
        </table>
      </div>
      {b100 != null && <p class="mb-3 text-sm text-muted-foreground">BIST 100'e göre beta <b class="text-foreground">{b100.toFixed(2)}</b> · korelasyon <b class="text-foreground">{c100?.toFixed(2)}</b> <span class="text-xs">(son 1 yıl, günlük getiriler; beta 1'den küçükse endeksten az oynak)</span></p>}
      <CompareChart client:only="react" series={[{ code: f.code, name: f.name, history: forChart(f.history, ["price"]) }, ...benches.map(([s, l]) => ({ code: s, name: l, history: forChart(bench[s], ["price"]) }))]} />
    </section>
  )}

  {roll && (
    <section class="mb-8">
      <h2 class="mb-3 font-semibold">Kayan 3 aylık getiri <span class="text-xs font-normal text-muted-foreground">herhangi bir günde 3 ay tutsaydın · {roll.n} pencere</span></h2>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {[["En kötü", pct(roll.min), roll.min], ["Medyan", pct(roll.median), roll.median], ["En iyi", pct(roll.max), roll.max]].map(([k, v, n]) => (
          <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">{k}</div><div class={`font-medium tabular-nums ${tone(n as number)}`}>{v}</div></div>
        ))}
        <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">Kazandıran pencere</div><div class="font-medium tabular-nums">{roll.pos.toFixed(0)}%</div></div>
      </div>
    </section>
  )}

  {(dd || rr?.sharpe != null) && (
    <section class="mb-8" data-section="risk">
      <h2 class="mb-3 font-semibold">Risk ve getiri kalitesi <span class="text-xs font-normal text-muted-foreground">son 1 yıl, günlük fiyatlar</span></h2>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
        {dd && (
          <div class="rounded-lg border p-3">
            <div class="text-xs text-muted-foreground">Maks. düşüş</div>
            <div class={`font-medium tabular-nums ${tone(dd.max)}`}>{pct(dd.max)}</div>
            {dd.max < 0 && <div class="mt-1 text-xs text-muted-foreground">{trDate(dd.peak)} → {trDate(dd.trough)} · {dd.recovered ? `${dd.recovery} günde toparlandı` : "henüz toparlanmadı"}</div>}
          </div>
        )}
        <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">Volatilite (yıllık)</div><div class="font-medium tabular-nums">{vol1 == null ? "–" : `${vol1.toFixed(2)}%`}</div></div>
        <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">Sharpe</div><div class={`font-medium tabular-nums ${tone(rr?.sharpe)}`}>{rr?.sharpe?.toFixed(2) ?? "–"}</div></div>
        <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">Sortino</div><div class={`font-medium tabular-nums ${tone(rr?.sortino)}`}>{rr?.sortino?.toFixed(2) ?? "–"}</div></div>
      </div>
      {rf != null && <p class="mt-2 text-xs text-muted-foreground">Sharpe/Sortino: risksiz getiriyi (TL para piyasası fonlarının 1Y medyanı, {pct(rf * 100)}) aşan getirinin oynaklığa oranı. 1'in üstü iyi kabul edilir; Sortino yalnız aşağı yönlü oynaklığı sayar.</p>}
    </section>
  )}

  {ranks.length > 0 && me && (
    <section class="mb-8" data-section="rank">
      <h2 class="mb-3 font-semibold">Kategorisinde sırası <span class="text-xs font-normal text-muted-foreground">{me.type} · aktif {cat.length} fon arasında (1 = en iyi)</span></h2>
      <div class="grid grid-cols-2 gap-3 md:grid-cols-5">
        {ranks.map(([k, r]) => (
          <div class="rounded-lg border p-3"><div class="text-xs text-muted-foreground">{k}</div><div class="font-medium tabular-nums">{r!.rank} / {r!.n}</div><div class="text-xs text-muted-foreground">ilk %{r!.top}</div></div>
        ))}
      </div>
    </section>
  )}

  {cal.length > 0 && (
    <section class="mb-8" data-section="calendar">
      <h2 class="mb-3 font-semibold">Takvim getirileri <span class="text-xs font-normal text-muted-foreground">aylık ve yıllık, % · içinde bulunulan dönem son fiyata kadar</span></h2>
      <div class="overflow-x-auto rounded-lg border">
        <table class="w-full text-xs tabular-nums">
          <thead class="bg-muted/50 text-right"><tr><th class="p-2 text-left">Yıl</th>{MONTHS.map((m) => <th class="p-2">{m}</th>)}<th class="p-2">Yıl</th></tr></thead>
          <tbody>
            {cal.map((r) => (
              <tr class="border-t"><td class="p-2 text-left font-medium">{r.year}</td>{r.months.map((v) => <td class={`p-2 text-right ${tone(v)}`}>{p1(v)}</td>)}<td class={`p-2 text-right font-medium ${tone(r.total)}`}>{p1(r.total)}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {holdings.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 font-semibold">Hisse portföyü <span class="text-xs font-normal text-muted-foreground">KAP Portföy Dağılım Raporu · {report} · yayın {trDate(published)} · portföy değerine oran</span></h2>
      <div class="grid gap-x-8 gap-y-1.5 text-sm md:grid-cols-2">
        {holdings.map((h) => (
          <div>
            <div class="flex justify-between"><a class="font-medium hover:underline" href={`/hisse/${h.ticker}`}>{h.ticker}</a><span class="tabular-nums">{h.weight.toFixed(2)}%</span></div>
            <div class="h-1.5 rounded bg-muted"><div class="h-1.5 rounded bg-primary" style={`width:${Math.min(h.weight, 100)}%`} /></div>
          </div>
        ))}
      </div>
      {change && (
        <div class="mt-4 rounded-lg border p-3 text-sm" data-testid="portfoy-degisim">
          <div class="mb-2 font-medium">Önceki rapora göre <span class="text-xs font-normal text-muted-foreground">{change.prev} → {change.cur} · ağırlık değişimi fiyat hareketini de içerir, 0,5 puandan küçükler gösterilmez</span></div>
          {[["Yeni giren", change.diff.added.map((h) => [h.ticker, `${h.weight.toFixed(2)}%`]), "text-emerald-600 dark:text-emerald-400"],
            ["Çıkarılan", change.diff.removed.map((h) => [h.ticker, `${h.weight.toFixed(2)}%`]), "text-red-600 dark:text-red-400"],
            ["Artırılan", change.diff.up.map((c) => [c.ticker, `+${c.delta.toFixed(2)}`]), "text-emerald-600 dark:text-emerald-400"],
            ["Azaltılan", change.diff.down.map((c) => [c.ticker, c.delta.toFixed(2)]), "text-red-600 dark:text-red-400"]].map(([k, items, cls]) => (
            (items as string[][]).length > 0 && (
              <div class="mb-1 flex flex-wrap items-baseline gap-x-3 gap-y-1"><span class="w-24 shrink-0 text-xs text-muted-foreground">{k}</span>
                {(items as string[][]).map(([t, v]) => <a class="hover:underline" href={`/hisse/${t}`}><b>{t}</b> <span class={`tabular-nums ${cls}`}>{v}</span></a>)}
              </div>
            )
          ))}
          {!change.diff.added.length && !change.diff.removed.length && !change.diff.up.length && !change.diff.down.length && <p class="text-xs text-muted-foreground">Belirgin değişiklik yok.</p>}
        </div>
      )}
    </section>
  )}

  {why && <p class="mb-8 rounded-lg border border-dashed p-3 text-sm text-muted-foreground"><b>Hisse portföyü yok:</b> {why}</p>}

  {news.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 font-semibold">KAP bildirimleri <span class="text-xs font-normal text-muted-foreground">son {news.length} bildirim</span></h2>
      <ul class="space-y-2 text-sm">
        {news.map((n) => (
          <li>
            <a class="hover:underline" href={n.url ?? `https://www.kap.org.tr/tr/Bildirim/${n.disclosure_index}`} target="_blank" rel="noopener noreferrer">
              <div class="font-medium">{n.subject}</div>
              <div class="text-xs text-muted-foreground">{trDate(n.published)} {n.published.slice(11, 16)}</div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {cmp.length > 1 && (
    <section class="mb-8">
      <h2 class="mb-3 font-semibold">İlk 4 rakiple karşılaştırma <span class="text-xs font-normal text-muted-foreground">seçili aralığın başı = 100</span></h2>
      <CompareChart client:only="react" series={cmp.map((c) => ({ code: c.code, name: c.name, history: forChart(c.history, ["price"]) }))} />
    </section>
  )}

  <div class="grid gap-8 md:grid-cols-2">
    <section>
      <h2 class="mb-3 font-semibold">Varlık dağılımı <span class="text-xs font-normal text-muted-foreground">{f.allocDate && trDate(f.allocDate)}{f.allocKap && " · KAP rapor dönemi sonu"}</span></h2>
      {alloc.length === 0 ? <p class="text-sm text-muted-foreground">Veri yok.</p> : (
        <ul class="space-y-1.5 text-sm">
          {alloc.map(([k, v]) => (
            <li>
              <div class="flex justify-between"><span>{label(k)}</span><span class="tabular-nums">{v.toFixed(2)}%</span></div>
              <div class="h-1.5 rounded bg-muted"><div class="h-1.5 rounded bg-primary" style={`width:${Math.min(v, 100)}%`} /></div>
            </li>
          ))}
        </ul>
      )}
    </section>
    <section>
      <h2 class="mb-3 font-semibold">Rakip fonlar <span class="text-xs font-normal text-muted-foreground">varlık dağılımı en benzer</span></h2>
      <ul class="space-y-1 text-sm">
        {rivals.map((r) => <li><a class="hover:underline" href={`/fon/${r.code}`}><b>{r.code}</b> {r.name}</a></li>)}
      </ul>
      {rivals.length > 0 && <a class="mt-3 inline-block text-sm underline" href={`/karsilastir?codes=${[f.code, ...rivals.slice(0, 4).map((r) => r.code)].join(",")}`}>İlk 4 rakiple karşılaştır</a>}
    </section>
    {overl.length > 0 && (
      <section>
        <h2 class="mb-3 font-semibold">Hisse portföyü en çok örtüşen fonlar <span class="text-xs font-normal text-muted-foreground">ortak hisselerin ağırlık toplamı (min)</span></h2>
        <ul class="space-y-1 text-sm">
          {overl.map((r) => <li class="flex justify-between gap-3"><a class="min-w-0 truncate hover:underline" href={`/karsilastir?codes=${f.code},${r.code}`}><b>{r.code}</b> {r.name}</a><span class="tabular-nums">{r.ov.toFixed(1)}%</span></li>)}
        </ul>
      </section>
    )}
  </div>
</Base>
