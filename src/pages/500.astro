---
import Base from "../layouts/Base.astro";
// Yakalanmamış hata (ör. DB erişilemiyor). DB'ye dokunmaz; hata ayrıntısı kullanıcıya gösterilmez, sunucu loguna düşer.
---
<Base title="Bir hata oluştu | TEFAS Fon Analiz" noindex>
  <div class="mx-auto max-w-xl space-y-4 py-12 text-center">
    <p class="text-sm font-medium text-muted-foreground">500</p>
    <h1 class="text-2xl font-semibold">Bir şeyler ters gitti</h1>
    <p class="text-sm text-muted-foreground">
      Sayfa şu an oluşturulamadı. Genelde geçicidir (veri güncellemesi sürüyor olabilir); birkaç saniye sonra tekrar deneyin.
    </p>
    <div class="flex justify-center gap-3 text-sm">
      <a href={Astro.url.pathname + Astro.url.search} class="rounded-md bg-primary px-4 py-2 font-medium text-primary-foreground hover:bg-primary/90">Tekrar dene</a>
      <a href="/fonlar/yat" class="rounded-md border px-4 py-2 hover:bg-accent">Fon listesi</a>
    </div>
  </div>
</Base>
