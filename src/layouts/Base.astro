---
import "../styles/global.css";
import { abs, jsonLd, SITE_DESC, SITE_NAME, type Crumb } from "../lib/seo";
// description/image: sayfaya özel paylaşım metni ve görseli; crumbs: JSON-LD BreadcrumbList; noindex: sorgu parametreli araç sayfaları
// path: kanonik yol (ör. /fon/aaa -> /fon/AAA); verilmezse istek yolu, sorgu parametresiz
type Props = { title?: string; description?: string; image?: string; crumbs?: Crumb[]; noindex?: boolean; path?: string };
const { title = SITE_NAME, description = SITE_DESC, image = "/og-image.png", crumbs = [], noindex = false, path: canonPath = Astro.url.pathname } = Astro.props as Props;
const canonical = abs(Astro.site, canonPath);
const img = abs(Astro.site, image);
// Üst menü: [adres, etiket, aktif sayılan yol önekleri]. Fon türleri, taramalar ve kurucular liste sayfasında; üç hesap aracı tek girişte.
const nav: [string, string, string[]][] = [
  ["/fonlar/yat", "Fonlar", ["/fonlar/", "/fon/", "/tarama", "/kurucu"]],
  ["/karsilastir", "Karşılaştır", ["/karsilastir"]],
  ["/hisse", "Hisse Ara", ["/hisse"]],
  ["/portfoy", "Portföyüm", ["/portfoy"]],
  ["/simulasyon", "Simülasyon", ["/simulasyon", "/bes-simulasyon", "/hedef"]],
];
const path = Astro.url.pathname;
const showDisclaimer = process.env.SHOW_DISCLAIMER === "1";
// Umami (çerezsiz ziyaret istatistiği): ikisi de verilirse yüklenir. data-umami-event özniteliği olan öğelerin tıklamaları olay olarak sayılır.
const umami = process.env.UMAMI_SRC && process.env.UMAMI_ID ? { src: process.env.UMAMI_SRC, id: process.env.UMAMI_ID } : null;
---
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Fon Analiz" />
    <!-- Tema: localStorage "tema" = acik | koyu (yoksa sistem). Boyamadan önce çalışır (beyaz parlama olmasın). Yazdırırken her zaman açık. -->
    <script is:inline>
      (() => {
        const root = document.documentElement, mq = matchMedia("(prefers-color-scheme: dark)");
        const metas = [...document.querySelectorAll('meta[name="theme-color"]')];
        const apply = () => {
          let t = null;
          try { t = localStorage.getItem("tema"); } catch {}
          const dark = t === "koyu" || (t !== "acik" && mq.matches);
          root.classList.toggle("dark", dark);
          root.style.colorScheme = dark ? "dark" : "light";
          metas.forEach((m, i) => (m.content = t ? (dark ? "#111111" : "#ffffff") : i ? "#111111" : "#ffffff"));
        };
        apply();
        window.__tema = apply;
        mq.addEventListener("change", apply);
        addEventListener("storage", (e) => e.key === "tema" && apply());
        addEventListener("beforeprint", () => { root.classList.remove("dark"); root.style.colorScheme = "light"; });
        addEventListener("afterprint", apply);
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={img} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="tr_TR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={img} />
    <script type="application/ld+json" set:html={jsonLd(Astro.site, { path: canonPath, title, description }, crumbs)} />
    {umami && <script is:inline defer src={umami.src} data-website-id={umami.id} data-do-not-track="true" />}
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    {showDisclaimer && (
      <div class="no-print border-b bg-amber-50 px-4 py-2 text-center text-xs text-amber-900 dark:bg-amber-950 dark:text-amber-200">
        Bu site yatırım tavsiyesi değildir. Veriler TEFAS'ın kamuya açık API'sinden derlenmiştir, sitenin verisi değildir ve doğruluğu garanti edilmez; yatırım kararı vermeden önce resmi kaynakları kontrol edin.
        <a href="/terms" class="underline">Detaylar</a>
      </div>
    )}
    <header class="no-print border-b">
      <nav class="relative mx-auto flex max-w-[1700px] items-center gap-x-4 px-4 sm:flex-wrap sm:gap-x-6 sm:gap-y-1 py-3 text-sm">
        <a href="/" class="font-semibold">TEFAS Fon Analiz</a>
        <button
          id="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-links"
          aria-label="Menü"
          class="ml-auto rounded p-2 hover:bg-accent sm:hidden"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6" /><line x1="4" y1="12" x2="20" y2="12" /><line x1="4" y1="18" x2="20" y2="18" /></svg>
        </button>
        <div id="nav-links" class="absolute inset-x-0 top-full z-40 hidden flex-col gap-1 border-b bg-background p-2 shadow-lg sm:static sm:z-auto sm:flex sm:w-auto sm:flex-row sm:items-center sm:gap-x-6 sm:gap-y-1 sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none">
          {nav.map(([h, l, pre]) => {
            const on = pre.some((p) => path.startsWith(p));
            return <a href={h} aria-current={on ? "page" : undefined} class={`rounded px-3 py-2 hover:bg-accent sm:rounded-none sm:px-0 sm:py-0 sm:hover:bg-transparent ${on ? "font-medium" : "text-muted-foreground hover:text-foreground"}`}>{l}</a>;
          })}
        </div>
        <!-- data-tema istemcide doldurulur; simge sırası: sistem -> açık -> koyu -->
        <button id="theme-toggle" type="button" data-tema="sistem" aria-label="Tema: sistem" title="Tema: sistem" class="group rounded p-2 hover:bg-accent sm:ml-auto">
          <svg class="hidden group-data-[tema=sistem]:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" /></svg>
          <svg class="hidden group-data-[tema=acik]:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
          <svg class="hidden group-data-[tema=koyu]:block" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
        </button>
      </nav>
    </header>
    <script>
      const toggle = document.getElementById("nav-toggle");
      const links = document.getElementById("nav-links");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        links?.classList.toggle("hidden", open);
        links?.classList.toggle("flex", !open);
      });

      const ORDER = ["sistem", "acik", "koyu"] as const;
      const NAME = { sistem: "sistem", acik: "açık", koyu: "koyu" };
      const theme = document.getElementById("theme-toggle")!;
      const current = (): (typeof ORDER)[number] => {
        try { const t = localStorage.getItem("tema"); return t === "acik" || t === "koyu" ? t : "sistem"; } catch { return "sistem"; }
      };
      const show = () => {
        const t = current();
        theme.dataset.tema = t;
        theme.setAttribute("aria-label", `Tema: ${NAME[t]}`);
        theme.title = `Tema: ${NAME[t]} (değiştirmek için tıkla)`;
      };
      show();
      theme.addEventListener("click", () => {
        const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
        try { next === "sistem" ? localStorage.removeItem("tema") : localStorage.setItem("tema", next); } catch {}
        (window as any).__tema?.();
        show();
      });
      addEventListener("storage", (e) => e.key === "tema" && show());

      // Service worker: sadece üretimde (dev'de Vite modüllerini önbelleğe almasın)
      if (import.meta.env.PROD && "serviceWorker" in navigator) addEventListener("load", () => navigator.serviceWorker.register("/sw.js").catch(() => {}));
    </script>
    <main class="mx-auto max-w-[1700px] px-3 py-4 sm:px-4 sm:py-6"><slot /></main>
    <footer class="no-print border-t mt-8 px-4 py-4 text-center text-xs text-muted-foreground">
      <a href="/terms" class="hover:text-foreground">Terms</a>
      <span class="mx-2">·</span>
      <a href="/privacy-policy" class="hover:text-foreground">Privacy Policy</a>
      <span class="mx-2">·</span>
      <a href="/api" class="hover:text-foreground">API ve MCP</a>
      <span class="mx-2">·</span>
      <a href="https://github.com/alperengozum/tefas-fon/blob/main/LICENSE" target="_blank" rel="noopener" class="hover:text-foreground">License</a>
    </footer>
  </body>
</html>
