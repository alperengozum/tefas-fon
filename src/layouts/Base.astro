---
import "../styles/global.css";
const { title = "TEFAS Fon Analiz" } = Astro.props;
const tabs = [["yat", "Yatırım Fonları"], ["bes", "Emeklilik (BES)"], ["byf", "BYF"], ["gyf", "GYF"]];
const path = Astro.url.pathname;
---
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <header class="border-b">
      <nav class="mx-auto flex max-w-[1700px] flex-wrap items-center gap-x-4 gap-y-1 px-4 sm:gap-x-6 py-3 text-sm">
        <a href="/" class="font-semibold">TEFAS Fon Analiz</a>
        {tabs.map(([k, l]) => (
          <a href={`/fonlar/${k}`} class={path === `/fonlar/${k}` ? "font-medium" : "text-muted-foreground hover:text-foreground"}>{l}</a>
        ))}
        {[["/karsilastir", "Karşılaştır"], ["/portfoy", "Portföyüm"], ["/simulasyon", "Simülasyon"], ["/favoriler", "★ Favorilerim"]].map(([h, l]) => (
          <a href={h} class={path === h ? "font-medium" : "text-muted-foreground hover:text-foreground"}>{l}</a>
        ))}
      </nav>
    </header>
    <main class="mx-auto max-w-[1700px] px-3 py-4 sm:px-4 sm:py-6"><slot /></main>
  </body>
</html>
